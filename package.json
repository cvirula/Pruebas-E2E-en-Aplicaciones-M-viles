{
  "name": "turno",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:gherkin": "node scripts/validate-bdd.mjs",
    "test:maestro": "npm run test:gherkin && maestro test .maestro",
    "test:maestro:report": "npm run test:gherkin && maestro test --format html --output maestro-report.html .maestro",
    "test:maestro:web": "npm run test:gherkin && maestro test .maestro-web",
    "test:maestro:web:report": "npm run test:gherkin && maestro test --format html --output maestro-web-report.html .maestro-web"
  },
  "private": true
}
